# `tavora project show` exercises the GET /api/sdk/project SDK
# decoder + the detail() formatter. The Project shape is a wire
# contract — every field below is something the SDK pins:
#   id, slug, name, description, created_at, updated_at, team_id
#
# Text mode renders name + ID + Slug + Description + Created with
# field() labels. JSON mode passes the SDK struct through verbatim.

env TAVORA_API_KEY=tvr_fake

tavora project show
stdout 'Project: Fake Project'
stdout 'ID:'
stdout '11111111-1111-1111-1111-111111111111'
stdout 'Slug:'
stdout 'fake-project'
stdout 'Description:'
stdout 'Mocked project for testscript'
! stderr .

tavora --output json project show
stdout '"id": "11111111-1111-1111-1111-111111111111"'
stdout '"slug": "fake-project"'
stdout '"name": "Fake Project"'
stdout '"team_id": "22222222-2222-2222-2222-222222222222"'
! stderr .
